# Copia a .env para pruebas locales (no lo subas a GitHub)
ODDS_API_KEY=           # cuotas (the-odds-api.com) — obligatoria
FOOTBALLDATA_IO_KEY=    # estadísticas y xG (footballdata.io)
GEMINI_API_KEY=        # analista IA (Google Antigravity)
REFRESH_TOKEN=pon-aqui-un-token-largo
# DEMO_MODE=1        # fuerza datos ficticios
# CACHE_HOURS=24     # cada cuánto se regeneran los picks
# DAYS_AHEAD=7       # ventana de partidos
# NUM_PICKS=10
# MIN_EDGE=0.02      # valor mínimo (2 %)
# MIN_ODDS=1.5
# MAX_ODDS=5.0
# MARKET_WEIGHT=0.7  # 1.0 = solo mercado, 0.0 = solo modelo
# ENABLED_LEAGUES=PL,LALIGA,UCL,UEL
# XG_WEIGHT=0.6          # peso del xG frente a goles reales
# HALF_LIFE_DAYS=75      # cuánto pesan los partidos recientes
# PREMATCH_XG_WEIGHT=0.3 # mezcla con el xG prepartido de footballdata.io
# KELLY_FRACTION=0.25
# ODDS_REGIONS=eu
# ODDS_MARKETS=h2h,totals
# ANALYST_ENABLED=1     # 0 para apagar el analista
# ANALYST_CANDIDATES=15
# ANALYST_MAX_ADJUST=0.03
# ANALYST_TIMEOUT=900
# ANALYST_AGENT=antigravity-preview-05-2026
